  "description": "Backend for the Japan Trip app: pin storage + dedupe, forwarded-booking inbox, and the TikTok/Instagram share-link parsing pipeline.",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p .",
