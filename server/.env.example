# Copy to .env and fill in. Nothing here is required just to run the server —
# it degrades gracefully without any of it (see README.md) — but each key
# turns on one real capability.

# Where the JSON "database" file lives. Defaults to ./data/db.json.
# DB_PATH=./data/db.json

PORT=4000

# Powers: TikTok/IG caption parsing (extractLocation) and forwarded-email
# field extraction (parseBookingEmail). Without it, both fall back to much
# weaker regex heuristics. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional — defaults to a fast/cheap current model. Override if you want a
# different one.
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
