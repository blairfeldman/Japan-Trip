# Copy to .env and fill in what you have. The app runs and looks right with
# none of these set — see README.md for exactly what's live vs. simulated
# at each level.

# Google Maps API key for the Map tab (Android). Without it the map area
# renders blank/gray — react-native-maps needs a real key to draw tiles.
# Also paste this same key into app.json under
# expo.android.config.googleMaps.apiKey (that one gets compiled into the
# app; this env var isn't read by react-native-maps itself, it's here so
# both places are easy to find together).
# Get one: https://developers.google.com/maps/documentation/android-sdk/get-api-key
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional — used for exact walking ETAs (Directions API) on the Now
# screen's leave-by countdown. Without it, ETAs fall back to a straight-line
# distance / average walking speed estimate (labeled as approximate in the
# UI). Reuses the same key as above if you enable the Directions API on it.
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# URL of the backend in server/ (see server/README.md). Without this, pins
# and the inbox stay local to the phone, and the Share Sheet always falls
# back to "add by hand" instead of auto-parsing TikTok/IG links.
EXPO_PUBLIC_API_BASE_URL=
