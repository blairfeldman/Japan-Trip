# Copy to .env and fill in what you have. The app runs and looks right with
# none of these set — see README.md for exactly what's live vs. simulated
# at each level.
#
# NOTE: .env is gitignored, so EAS Build (which uploads only git-tracked
# files) does NOT see anything in here. For cloud builds these same values
# have to be set as EAS environment variables as well — see the "Building a
# real APK" section of README.md. Setting them only here and then building
# is the easy way to get a grey map in a build that worked in Expo Go.

# Google Maps API key for the Map tab (Android). app.config.js reads it from
# here and compiles it into the native build, and src/services/location.ts
# uses the same value for Directions ETAs — one key, one place.
#
# Expo Go does NOT need this: it draws the map with its own Google key. It is
# required for a standalone/dev build, where a missing key means a grey map.
# Enable "Maps SDK for Android" on the key, and "Directions API" too if you
# want exact walking times instead of straight-line estimates.
# Get one: https://developers.google.com/maps/documentation/android-sdk/get-api-key
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# URL of the backend in server/ (see server/README.md). Without this, pins
# and the inbox stay local to the phone, and the Share Sheet always falls
# back to "add by hand" instead of auto-parsing TikTok/IG links.
EXPO_PUBLIC_API_BASE_URL=
