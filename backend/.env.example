# Local development only. On Fly these are set with `fly secrets set`, never
# committed — see README.md.

# Shared bearer token both phones send. Generate with: openssl rand -hex 32
# Unset locally it defaults to "dev-token"; on Fly the app refuses to boot
# without it rather than coming up unprotected.
APP_TOKEN=

# Reads the place out of a shared TikTok/Instagram caption. Without it, shares
# land as "failed" with the missing-key reason; ordinary sync is unaffected.
ANTHROPIC_API_KEY=

# Turns the place name into coordinates (Places API New). Same deal.
GOOGLE_MAPS_API_KEY=

# Optional model override.
# EXTRACT_MODEL=claude-haiku-4-5-20251001
